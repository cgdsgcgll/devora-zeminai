{
  "name": "zeminai-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "types:generate": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests *.json *.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  }
}
