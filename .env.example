ENVIRONMENT=development
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
DATABASE_URL=postgresql+psycopg://zeminai_dev:REPLACE_LOCALLY@127.0.0.1:5432/zeminai
GITHUB_TOKEN=

# Optional GitHub App account/access provenance (separate from public fetching).
# Public App slug from https://github.com/apps/<slug>; lowercase letters/digits/hyphens.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://127.0.0.1:8000/github/callback
# Persist the SAME encryption key in your ignored root .env across restarts. Never regenerate on startup.
GITHUB_APP_ENCRYPTION_KEY=
CORS_ORIGINS=["http://127.0.0.1:3000"]
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_BYTES=24000
LLM_MAX_OUTPUT_TOKENS=4000

# Local HTTP only. Set true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=zeminai_session
SESSION_TTL=604800
AUTH_WINDOW_SECONDS=900
AUTH_IP_ATTEMPTS=60
AUTH_EMAIL_ATTEMPTS=10

# Development fallback only; production requires a separate random secret (32+ characters).
# Inject RATE_LIMIT_KEY from your secret manager; never commit it.
AI_WINDOW_SECONDS=3600
AI_USER_ATTEMPTS=10
AI_IP_ATTEMPTS=60
COMPUTE_WINDOW_SECONDS=60
COMPUTE_USER_ATTEMPTS=60
COMPUTE_IP_ATTEMPTS=180
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=5
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000


# Durable source-analysis queue (apply all migrations through a18_analysis_diagnostics before starting the API).
# Threads are per API process, not a global provider concurrency/spend cap.
ANALYSIS_WORKER_ENABLED=true
ANALYSIS_WORKER_THREADS=2
ANALYSIS_JOB_TIMEOUT_SECONDS=600
ANALYSIS_QUEUE_TIMEOUT_SECONDS=600

# Per-process provider capacity; acquire before job claim. Restart after changing.
ANALYSIS_PROVIDER_MAX_CONCURRENCY=1
