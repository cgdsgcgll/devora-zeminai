ENVIRONMENT=development
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/zeminai
GITHUB_TOKEN=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_BYTES=24000
LLM_MAX_OUTPUT_TOKENS=4000

# Local HTTP only. Set true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=zeminai_session
SESSION_TTL=604800
AUTH_WINDOW_SECONDS=900
AUTH_IP_ATTEMPTS=60
AUTH_EMAIL_ATTEMPTS=10

# Development fallback only; production requires a separate random secret (32+ characters).
# Inject RATE_LIMIT_KEY from your secret manager; never commit it.
AI_WINDOW_SECONDS=3600
AI_USER_ATTEMPTS=10
AI_IP_ATTEMPTS=60
COMPUTE_WINDOW_SECONDS=60
COMPUTE_USER_ATTEMPTS=60
COMPUTE_IP_ATTEMPTS=180
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=5
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000
